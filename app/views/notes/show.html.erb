<%# /notes/:id — detail view for a single whisper. Mirrors
    prototype/screens-3.jsx (DetailScreen). The full ink-bleed vanish
    animation is deferred to phase 5; here it stays a static card. %>
<div class="relative mx-auto flex min-h-screen max-w-md flex-col bg-bg px-6 pb-10 pt-12">
  <%# Square back button — matches the chevron-in-card pattern from /notes/new. %>
  <div class="flex">
    <%= link_to map_path,
          aria: { label: t("detail.back") },
          class: "flex h-9 w-9 shrink-0 items-center justify-center rounded-card border border-card-edge bg-card text-ink shadow-card" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 6l-6 6 6 6"/>
      </svg>
    <% end %>
  </div>

  <%# Status banner — only rendered for inactive notes the owner is reading
      from their trail. Tells them the note is no longer reachable from the
      map but remains visible to them as personal history. %>
  <% if @note.inactive? %>
    <div class="mt-6 flex items-center gap-2.5 rounded-card border border-card-edge bg-bg-deep px-4 py-2.5"
         data-note-status="<%= @note.vanished_reason %>">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
           class="text-ink-soft" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 7v5l3 2"/>
      </svg>
      <div class="flex-1">
        <p class="font-mono text-[10px] uppercase tracking-eyebrow text-accent">
          <%= t("detail.status.#{@note.vanished_reason}") %>
        </p>
        <p class="mt-0.5 font-serif text-[13px] text-ink-soft">
          <%= t("detail.status.body") %>
        </p>
      </div>
    </div>
  <% end %>

  <%# Eyebrow: "12M AWAY · LEFT 4H AGO" in accent red, with concentric-circles "near" icon. %>
  <div class="mt-7 flex items-center gap-2 font-mono text-[10px] uppercase tracking-eyebrow text-accent">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
      <circle cx="12" cy="12" r="2.5" fill="currentColor"/>
      <circle cx="12" cy="12" r="6" stroke-width="1.4" opacity="0.55"/>
      <circle cx="12" cy="12" r="9.5" stroke-width="1.2" opacity="0.25"/>
    </svg>
    <span>
      <% if @note.distance_m %><%= t("detail.eyebrow.distance", meters: @note.distance_m) %> · <% end %><%= t("detail.eyebrow.left_ago", time: time_ago_in_words(@note.created_at)) %>
    </span>
  </div>

  <%# Note card with highlighter mark + dashed footer carrying the language tag. %>
  <article class="relative mt-4 rounded-hero border border-card-edge bg-card px-6 py-7 shadow-hero">
    <%# Yellow highlighter swipe along the top, slightly rotated. %>
    <span class="absolute -top-2 left-7 h-[18px] w-14 -rotate-3 rounded-sm bg-accent-soft opacity-70" aria-hidden="true"></span>

    <p class="whitespace-pre-line font-serif text-[22px] leading-[30px] text-ink">
      <%= @note.content %>
    </p>

    <div class="mt-5 flex items-center justify-between border-t border-dashed border-card-edge pt-4">
      <span aria-hidden="true"></span>
      <span class="rounded-sm bg-bg-deep px-2 py-0.5 font-mono text-[10px] uppercase tracking-eyebrow text-ink-soft">
        <%= @note.language.upcase %>
      </span>
    </div>
  </article>

  <%# Lifecycle bars %>
  <div class="mt-7 flex flex-col gap-3.5">
    <%# Fades in %>
    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-eyebrow text-ink-soft">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 7v5l3 2"/>
          </svg>
          <%= t("detail.lifecycle.fades_in") %>
        </span>
        <span class="font-serif text-sm font-semibold text-ink">
          <% if @note.time_left_seconds.nil? %>
            <%= t("detail.lifecycle.permanent") %>
          <% else %>
            <%= distance_of_time_in_words(Time.current, Time.current + @note.time_left_seconds) %>
          <% end %>
        </span>
      </div>
      <% if @note.time_left_seconds && @note.expires_at %>
        <%# Bucket against the original lifetime ceiling (capped at 1 day for a
            stable visual scale; longer notes start near full). %>
        <% pct = (@note.time_left_seconds.to_f / 1.day.to_i * 100).clamp(0, 100) %>
        <div class="h-1 w-full overflow-hidden rounded-full bg-bg-deep">
          <div class="h-full rounded-full bg-accent <%= progress_width_class(pct) %>"></div>
        </div>
      <% end %>
    </div>

    <%# Reads left %>
    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-eyebrow text-ink-soft">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/>
            <circle cx="12" cy="12" r="2.5"/>
          </svg>
          <%= t("detail.lifecycle.reads_left") %>
        </span>
        <span class="font-serif text-sm font-semibold text-ink">
          <% if @note.views_remaining.nil? %>
            <%= t("detail.lifecycle.unlimited") %>
          <% else %>
            <%= @note.views_remaining %> / <%= @note.max_views %>
          <% end %>
        </span>
      </div>
      <% if @note.views_remaining && @note.max_views %>
        <% pct = ((@note.views_remaining.to_f / @note.max_views) * 100).clamp(0, 100) %>
        <div class="h-1 w-full overflow-hidden rounded-full bg-bg-deep">
          <div class="h-full rounded-full bg-accent <%= progress_width_class(pct) %>"></div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Action row: whisper back (primary, full-width) + report (secondary, auto-width).
      Both disabled until phase 5 wires replies and moderation. %>
  <div class="mt-6 flex gap-2">
    <button type="button" disabled
            class="flex flex-1 cursor-not-allowed items-center justify-center gap-1.5 rounded-button border border-card-edge bg-card px-4 py-3 font-sans text-sm font-medium text-ink opacity-55"
            title="<%= t('nav.soon') %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M2 12c2 0 2-3 4-3s2 3 4 3 2-3 4-3 2 3 4 3 2-3 4-3"/>
      </svg>
      <%= t("detail.whisper_back") %>
    </button>
    <% if @note.user_id == Current.user&.id && !@note.inactive? %>
      <%= button_to t("detail.archive.cta"),
            note_path(@note),
            method: :delete,
            data: { turbo_confirm: t("detail.archive.confirm") },
            class: "rounded-button border border-card-edge bg-card px-4 py-3 font-sans text-sm font-medium text-ink-soft" %>
    <% elsif @note.user_id == Current.user&.id && @note.inactive? %>
      <%# Owner re-reading their own vanished/archived note from the trail.
          Archive doesn't make sense (already inactive); show a locked label. %>
      <button type="button" disabled
              class="cursor-not-allowed rounded-button border border-card-edge bg-card px-4 py-3 font-sans text-sm font-medium text-ink-soft opacity-55"
              title="<%= t("detail.status.#{@note.vanished_reason}") %>">
        <%= t("detail.status.locked") %>
      </button>
    <% else %>
      <button type="button" disabled
              class="cursor-not-allowed rounded-button border border-card-edge bg-card px-4 py-3 font-sans text-sm font-medium text-ink-soft opacity-55"
              title="<%= t('nav.soon') %>">
        <%= t("detail.report") %>
      </button>
    <% end %>
  </div>
</div>

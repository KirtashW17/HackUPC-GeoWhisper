<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f5efe4">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="icon" type="image/svg+xml" href="<%= asset_path("logos/monogram-g/favicon.svg") %>">
    <link rel="icon" type="image/png" sizes="16x16"  href="<%= asset_path("logos/monogram-g/favicon-16.png") %>">
    <link rel="icon" type="image/png" sizes="32x32"  href="<%= asset_path("logos/monogram-g/favicon-32.png") %>">
    <link rel="icon" type="image/png" sizes="48x48"  href="<%= asset_path("logos/monogram-g/favicon-48.png") %>">
    <link rel="apple-touch-icon" sizes="180x180" href="<%= asset_path("logos/monogram-g/apple-touch-icon.png") %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Caveat:wght@400;500&display=swap">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "leaflet", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "layouts/pwa_register" %>
  </head>

  <body class="min-h-screen bg-bg text-ink font-serif antialiased">
    <% global_flash = flash.to_h.except("form_alert") %>
    <% if global_flash.any? %>
      <div class="fixed inset-x-0 top-4 z-50 mx-auto flex max-w-md flex-col gap-2 px-4">
        <% global_flash.each do |type, message| %>
          <div data-controller="flash"
               role="status"
               class="gw-flash flex items-center gap-3 rounded-button border border-card-edge bg-card px-4 py-3 text-sm shadow-card <%= type.to_s == "alert" ? "text-accent" : "text-ink-soft" %>">
            <span class="flex-1"><%= message %></span>
            <button type="button"
                    data-action="click->flash#close"
                    aria-label="<%= t("flash.dismiss") %>"
                    class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-ink-faint hover:bg-bg-deep">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18"/>
              </svg>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>

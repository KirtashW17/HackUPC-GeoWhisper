<div class="relative mx-auto flex min-h-screen max-w-md flex-col bg-bg">
  <div class="absolute inset-0 bg-gradient-to-b from-bg-deep/40 via-bg to-bg pointer-events-none"></div>

  <div class="relative flex flex-1 flex-col px-7 pt-20 pb-7">
    <div class="mb-5 flex h-[52px] w-[52px] items-center justify-center rounded-card border border-card-edge bg-card font-serif text-2xl italic font-semibold text-accent">
      g.
    </div>

    <p class="mb-1.5 font-mono text-[11px] uppercase tracking-eyebrow text-accent">
      <%= t("auth.login.eyebrow") %>
    </p>

    <h1 class="mb-7 text-balance font-serif text-[32px] font-medium leading-9 text-ink tracking-tight">
      <%= t("auth.login.headline.prefix") %>
      <span class="italic text-accent"><%= t("auth.login.headline.emphasis") %></span>
      <%= t("auth.login.headline.suffix") %>
    </h1>

    <%= form_with url: session_path, local: true, class: "flex flex-col gap-3" do |f| %>
      <% if flash[:alert].present? && !flash[:alert].is_a?(ActionDispatch::Flash::FlashHash) %>
        <div class="rounded-card border border-accent/30 bg-accent-soft/40 px-4 py-2.5 text-sm text-accent">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <div class="rounded-card border border-card-edge bg-card px-3.5 py-2.5">
        <label for="email" class="block font-mono text-[9px] uppercase tracking-eyebrow text-ink-soft"><%= t("auth.fields.email") %></label>
        <%= email_field_tag :email, params[:email], required: true, autofocus: true, autocomplete: "email",
              class: "mt-0.5 w-full bg-transparent font-serif text-base text-ink outline-none placeholder:text-ink-faint" %>
      </div>

      <div class="rounded-card border border-card-edge bg-card px-3.5 py-2.5">
        <label for="password" class="block font-mono text-[9px] uppercase tracking-eyebrow text-ink-soft"><%= t("auth.fields.password") %></label>
        <%= password_field_tag :password, nil, required: true, autocomplete: "current-password",
              class: "mt-0.5 w-full bg-transparent font-sans text-base text-ink outline-none" %>
      </div>

      <div class="my-4 flex items-center gap-2.5 font-mono text-[10px] uppercase tracking-eyebrow text-ink-faint">
        <span class="h-px flex-1 bg-card-edge"></span>
        <span><%= t("auth.divider_or") %></span>
        <span class="h-px flex-1 bg-card-edge"></span>
      </div>

      <button type="button" disabled
              class="relative flex cursor-not-allowed items-center justify-center gap-2.5 rounded-button border border-card-edge bg-card px-4 py-3 font-sans text-sm font-medium text-ink opacity-55">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285f4" d="M22.5 12.2c0-.8-.1-1.4-.2-2H12v3.8h5.9c-.3 1.4-1 2.6-2.2 3.4v2.8h3.6c2.1-2 3.2-4.8 3.2-8z"/>
          <path fill="#34a853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.8c-1 .7-2.3 1.1-3.7 1.1-2.9 0-5.3-2-6.2-4.6H2v2.9C3.8 20.5 7.6 23 12 23z"/>
          <path fill="#fbbc04" d="M5.8 14c-.2-.7-.4-1.4-.4-2.2s.1-1.5.4-2.2V6.7H2C1.2 8.3.7 10.1.7 12s.5 3.7 1.3 5.3L5.8 14z"/>
          <path fill="#ea4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.6l3.2-3.2C17.5 2.1 15 1 12 1 7.6 1 3.8 3.5 2 7l3.8 2.9C6.7 7.4 9.1 5.4 12 5.4z"/>
        </svg>
        <%= t("auth.google_continue") %>
        <span class="absolute right-3.5 rounded-sm bg-bg-deep px-1.5 py-0.5 font-mono text-[9px] font-semibold tracking-eyebrow text-ink-soft">
          <%= t("auth.soon") %>
        </span>
      </button>

      <div class="flex-1"></div>

      <button type="submit"
              class="mt-6 rounded-button bg-accent px-0 py-3.5 font-sans text-base font-semibold tracking-wide text-bg shadow-cta">
        <%= t("auth.login.submit") %>
      </button>

      <p class="mt-3 text-center font-serif text-sm italic text-ink-soft">
        <%= t("auth.login.no_account") %>
        <%= link_to t("auth.login.create_link"), new_registration_path,
              class: "font-sans font-semibold not-italic text-accent" %>
      </p>
    <% end %>
  </div>
</div>
